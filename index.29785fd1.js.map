var mainImage = document.querySelector("#largeImg");
document.addEventListener("click", function(e) {
    var clickedImg;
    if (e.target.tagName === "img") clickedImg = e.target;
    else if (e.target.tagName === "a") clickedImg = e.target.querySelector("img");
